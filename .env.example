# ==============================================================================
# KHEL GALLI - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Application URL (Your live deployed Vercel domain, without trailing slash)
APP_URL=https://your-project.vercel.app

# Firebase Configuration
FIREBASE_PROJECT_ID=gen-lang-client-0458229126
FIRESTORE_DATABASE_ID=(default)
# FIREBASE_SERVICE_ACCOUNT_KEY: (Optional for client, Recommended for backend admin routes / webhooks)
# Generated from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste the raw JSON or single-line JSON string here:
FIREBASE_SERVICE_ACCOUNT_KEY=

# Payment Gateway 1: Cashfree Payments (Optional if using ZapUPI)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=SANDBOX # or PRODUCTION
CASHFREE_WEBHOOK_SECRET=

# Payment Gateway 2: ZapUPI Payments (Optional if using Cashfree)
ZAPUPI_API_KEY=
ZAPUPI_ENV=TEST # or LIVE
ZAPUPI_BASE_URL=https://pay.zapupi.com

# Image Hosting: ImgBB (For match screenshots and avatar uploads)
IMGBB_API_KEY=
VITE_IMGBB_API_KEY=

