rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Authentication & Role Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "XoXyXcnrlzOaMIKKolXnU3mT9xn1" ||
        request.auth.token.get('email', '') == "khelgallli@gmail.com" ||
        request.auth.token.get('email', '') == "qupagaming@gmail.com" || 
        request.auth.token.get('email', '') == "mahendrathakur9009@gmail.com" ||
        request.auth.token.get('email', '') == "mahendrar9009@gmail.com"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read, get, list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Matches / Tournaments ---
    match /matches/{matchId} {
      allow read, list, get: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['players', 'playersCount'])
      );
    }

    // --- Registrations ---
    match /registrations/{registrationId} {
      allow read, get, list: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- Transactions ---
    match /transactions/{transactionId} {
      allow read, get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- Games ---
    match /games/{gameId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // --- Game Modes ---
    match /gameModes/{modeId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // --- Game Rules ---
    match /gameRules/{ruleId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // --- App Settings ---
    match /appSettings/{settingId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // --- Banners ---
    match /banners/{bannerId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // --- Match Results ---
    match /matchResults/{matchId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // --- Payment Settings ---
    match /paymentSettings/{gatewayId} {
      allow read, list, get: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read, list, get: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- Tournaments (Legacy / Alias collection) ---
    match /tournaments/{tournamentId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    // --- Meta & Counters ---
    match /meta/{metaId} {
      allow read, write: if isAdmin();
    }
  }
}
